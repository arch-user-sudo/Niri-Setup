# Picom configuration file

# Enable vsync




# Shadows
shadow = false;
shadow-color = "#00000ff"
shadow-radius = 0;
shadow-offset-x = 10;
shadow-offset-y = -10;
shadow-opacity = 0.7;
shadow-exclude = [
  "class_g = 'Conky'",
  "class_g = 'Polybar'"
];

# Transparency
inactive-opacity = 1.0;
active-opacity = 1.0;
frame-opacity = 0.7;
menu-opacity = 0.7;

# Opacity rules (example, all windows opaque)
#opacity-rule = [
#  "90:class_g = 'Alacritty'"
#];

# Other general settings
backend = "glx";
glx-no-stencil = false;
glx-copy-from-front = true;
xrender-sync-fence = true;

# No shadows on docks or panels
#wintypes:
#{
#  dock = { shadow = false; };
#  desktop = { shadow = false; };
#};



# --- Blur ---
blur-method = "dual_kawase";
blur-strength = 7;
blur-background = true;
blur-background-fixed = false;

detect-rounded-corners = false;
corner-radius = 0;
round-borders = 0;

# Disable all animations and fading
fading = True;
fade-in-step = 0.7;
fade-out-step = 0.7;

vsync = true;

