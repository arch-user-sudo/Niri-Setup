(defwidget logo []
     (eventbox 
   :onclick "bash ~/wp.sh"
	(box 
	   (button 
	    :class "symbol"
		:halign "start"
		:vexpand true
		:space-evenly false
		:spacing "0"
		:css "* {margin-left: 5px; margin-right: 20px;}"
		(label :text "󰍜")))))


(defwidget audio []
   (eventbox 
   :onclick "bash ~/menu2.sh"
   :onscroll "sh -c 'if [ \"{}\" == \"up\" ]; then pactl set-sink-volume @DEFAULT_SINK@ +5%; else pactl set-sink-volume @DEFAULT_SINK@ -5%; fi'" 
        
	(box
	  (button 
	    :class "symbol"
	:halign "center"
  :valign "center"	:vexpand true
		:space-evenly false
		:spacing "0"
		(label :text " " )))))

(defwidget wifi []
    (eventbox 
   :onclick "bash ~/menu2.sh"
	(box 
	   (button
	    :class "symbol"
		:halign "start"
  :valign "center"
		:vexpand true
		:space-evenly false
		:spacing "0"
		(label :text "󱝉")))))

(defwidget bt []
    (eventbox 
   :onclick "alacritty -e bluetuith &"
	(box 
	   (button
	    :class "logo"
		:halign "center"
  :valign "center"
		:vexpand true
		:space-evenly false
		:spacing "0"
		(label :text "")))))

(defwidget systray-container []
    (box :class "systray-container"
      :orientation "h"
      :halign "start"
	  :vexpand true
	  :spacing 5
      ;; The actual system tray widget
      (systray :spacing 10 :icon-size 12)
    ))

(defwidget logo-tray []
	(box
		:class "side-stuff"
		:halign "start"
		:space-evenly true
		:spacing "5"
		(box
			:space-evenly true
			:spacing "0"

			(logo)
      (systray-container)
			)))

; ..:: UTILITIES ::..

(defwidget sep [] (box :hexpand false (label :class "sep" :text "|")))

(deflisten active-workspaces :initial "N/A" "xprop -spy -root _NET_DESKTOP_NAMES")
(deflisten current-workspace-index :initial "N/A" `xprop -spy -root _NET_CURRENT_DESKTOP`)

; get active window name... still didn't figure it out
; (deflisten :initial "N/A" "")

(defpoll brightness-level :interval "5s" :initial "N/A" "scripts/getbright.sh")

; it'd be nice if it was a deflisten...
(defpoll volume :interval "0.01s" :initial "N/A" "scripts/getvol.sh")

(defpoll today :interval "1h" :initial "N/A" "date +'%a %d %b'")

(defpoll time :interval "5s" :initial "N/A" "date +'%I:%M %p  '")

(defpoll net-name :interval "60s" :initial "N/A" "nmcli -t -f NAME c show --active | head -n 1")

(defpoll net-strength :interval "5s" :initial `N/A`
	`nmcli -t -f SIGNAL,ACTIVE device wifi | awk -F':' '{if($2=="yes")print$1}'`)


