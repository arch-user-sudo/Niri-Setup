Used popsicle-bin to write iso and img files to USB. (RUfus-like tool) 





33LASTEST FOR OPTIMIZED HASWELL target-cpu

RUSTFLAGS="-C target-cpu=haswell -C opt-level=2 -C linker=clang -C link-arg=-fuse-ld=lld" \
                                  CARGO_PROFILE_RELEASE_LTO=thin \
                                  CARGO_PROFILE_RELEASE_CODEGEN_UNITS=4 \
                                  CARGO_PROFILE_RELEASE_PANIC=abort \
                                  cargo build --release
